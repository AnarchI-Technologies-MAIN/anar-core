{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anarchi:anar-core:decision-receipt:v1",
  "title": "Anar-Core decision receipt projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "decision_id",
    "request_id",
    "principal_id",
    "organization_id",
    "membership_id",
    "authenticator_id",
    "capability_id",
    "capability_version",
    "outcome",
    "reason_codes",
    "request_semantic_hash",
    "cal_semantic_hash",
    "evaluation_snapshot_hash",
    "policy_bundle_hash",
    "evidence_bundle_hash",
    "dependency_bundle_hash",
    "principal_global_sequence",
    "organization_decision_sequence",
    "principal_global_revocation_epoch",
    "organization_revocation_epoch",
    "canonical_receipt_sha256"
  ],
  "properties": {
    "receipt_id": {"type": "string", "format": "uuid"},
    "decision_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string", "format": "uuid"},
    "principal_id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "format": "uuid"},
    "membership_id": {"type": "string", "format": "uuid"},
    "authenticator_id": {"type": "string", "format": "uuid"},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$"},
    "capability_version": {"type": "integer", "minimum": 1},
    "outcome": {"enum": ["ALLOW", "DENY", "REQUIRE_APPROVAL"]},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "request_semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cal_semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "principal_global_sequence": {"type": "integer", "minimum": 0},
    "organization_decision_sequence": {"type": "integer", "minimum": 0},
    "principal_global_revocation_epoch": {"type": "integer", "minimum": 0},
    "organization_revocation_epoch": {"type": "integer", "minimum": 0},
    "canonical_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

